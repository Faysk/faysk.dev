---
import type { Locale } from "@data/site";
import { site } from "@data/site";
import { getCopy } from "@i18n/index";
import "@styles/site.css";
import "@styles/pages.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
  type?: "website" | "article";
}
const { locale, title, description, image = "/assets/img/og-card.png", imageAlt = "Faysk — engineering portfolio", canonicalPath = Astro.url.pathname, type = "website" } = Astro.props;
const copy = getCopy(locale);
const pageTitle = title ?? copy.meta.title;
const pageDescription = description ?? copy.meta.description;
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const socialImage = new URL(image, site.url).toString();
const currentWithoutLocale = canonicalPath.replace(/^\/(en|pt)/, "/");
const alternateEn = new URL("/en" + currentWithoutLocale, site.url).toString();
const alternatePt = new URL("/pt" + currentWithoutLocale, site.url).toString();
const personSchema = {"@context":"https://schema.org","@type":"Person",name:site.personName,alternateName:site.brand,url:site.url,jobTitle:"DevOps Engineer",email:"mailto:"+site.email,sameAs:[site.github,site.linkedin],knowsAbout:["DevOps","Cloud infrastructure","CI/CD","Automation","Infrastructure as Code","Product engineering"]};
const websiteSchema = {"@context":"https://schema.org","@type":"WebSite",name:site.brand,url:site.url,inLanguage:["en","pt"]};
---
<!doctype html>
<html lang={locale} data-theme-preference="system">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script is:inline>(()=>{try{const p=localStorage.getItem("faysk-theme")||"system";const e=p==="system"?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):p;document.documentElement.dataset.theme=e;document.documentElement.dataset.themePreference=p}catch{document.documentElement.dataset.theme="dark"}})();</script>
<meta name="description" content={pageDescription} /><meta name="author" content={site.personName} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#0b0e0c" media="(prefers-color-scheme: dark)" /><meta name="theme-color" content="#f3f5ef" media="(prefers-color-scheme: light)" />
<meta property="og:site_name" content={site.brand} /><meta property="og:locale" content={locale==="pt"?"pt_PT":"en_GB"} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={pageDescription} /><meta property="og:image" content={socialImage} /><meta property="og:image:alt" content={imageAlt} /><meta property="og:type" content={type} /><meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={pageDescription} /><meta name="twitter:image" content={socialImage} />
<link rel="canonical" href={canonicalUrl} /><link rel="alternate" hreflang="en" href={alternateEn} /><link rel="alternate" hreflang="pt" href={alternatePt} /><link rel="alternate" hreflang="x-default" href={alternateEn} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" /><link rel="manifest" href="/site.webmanifest" /><title>{pageTitle}</title>
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} /><script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</head>
<body><a class="skip-link" href="#main-content">Skip to content</a><slot /></body>
</html>
