---
import { site } from "@data/projects";
---

<div class="contact-form-shell">
  <form class="contact-form" data-contact-form>
    <div class="contact-field-grid">
      <label class="contact-field">
        <span>Name</span>
        <input name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
      </label>

      <label class="contact-field">
        <span>Email</span>
        <input name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required />
      </label>
    </div>

    <label class="contact-field">
      <span>Subject</span>
      <input name="subject" type="text" minlength="3" maxlength="140" required />
    </label>

    <label class="contact-field">
      <span>Message</span>
      <textarea name="message" rows="7" minlength="10" maxlength="4000" required></textarea>
    </label>

    <div class="contact-honeypot" aria-hidden="true">
      <label>
        Leave this field empty
        <input name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="contact-submit-row">
      <button class="button button-primary" type="submit">Send message</button>
      <p class="contact-status" role="status" aria-live="polite" data-contact-status></p>
    </div>

    <p class="contact-privacy">
      Your message is sent through our email provider and is not stored by this site. Please do not include sensitive information.
    </p>
  </form>

  <p class="contact-direct">
    Prefer to start directly?
    <a href={"mailto:" + site.contactEmail}>{site.contactEmail}</a>
  </p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLElement>("[data-contact-status]");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && submitButton) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries());
      submitButton.disabled = true;
      status.textContent = "Sending your message…";
      form.dataset.state = "sending";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = (await response.json().catch(() => ({}))) as {
          message?: string;
          error?: string;
        };

        if (!response.ok) {
          throw new Error(result.error ?? "Message could not be sent.");
        }

        form.reset();
        form.dataset.state = "sent";
        status.textContent = result.message ?? "Your message has been sent.";
      } catch (error) {
        form.dataset.state = "error";
        status.textContent =
          error instanceof Error
            ? `${error.message} Please use the direct email link below.`
            : "Message could not be sent. Please use the direct email link below.";
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
