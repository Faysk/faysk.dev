---
import type { Locale } from "@data/site";
import { site } from "@data/site";
import { experience, capabilities, projects } from "@data/projects";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const labels = locale === "pt"
  ? {
      role: "DevOps Engineer · Cloud · Automação · Product Engineering",
      intro: "Profissional de tecnologia com experiência prática desde suporte e desenvolvimento até infraestrutura, automação, CI/CD e operações de produção.",
      print: "Imprimir / salvar PDF",
      experience: "Experiência",
      capabilities: "Capacidades",
      selected: "Projetos selecionados",
      links: "Links",
      present: "Atual"
    }
  : {
      role: "DevOps Engineer · Cloud · Automation · Product Engineering",
      intro: "Technology professional with hands-on experience spanning support and software through infrastructure, automation, CI/CD and production operations.",
      print: "Print / save as PDF",
      experience: "Experience",
      capabilities: "Capabilities",
      selected: "Selected work",
      links: "Links",
      present: "Present"
    };
const featured = projects.filter((project) => project.featured).slice(0, 4);
---

<main class="cv" id="main-content">
  <header class="cv-header">
    <div>
      <a class="case-back print-hide" href={"/" + locale + "/"}>← faysk.dev</a>
      <p class="eyebrow">{site.brand} / {site.personName}</p>
      <h1>{site.personName}</h1>
      <p class="cv-role">{labels.role}</p>
      <p class="cv-intro">{labels.intro}</p>
    </div>
    <div class="cv-actions">
      <button class="button button-primary print-hide" type="button" data-print-cv>{labels.print}</button>
      <div class="cv-contact">
        <span>{site.location}</span>
        <a href={"mailto:" + site.email}>{site.email}</a>
        <a href={site.linkedin}>LinkedIn ↗</a>
        <a href={site.github}>GitHub ↗</a>
      </div>
    </div>
  </header>

  <section class="cv-section">
    <h2>{labels.experience}</h2>
    <div class="cv-list">
      {experience.map((item) => (
        <article>
          <div class="cv-period">{item.period.replace("Present", labels.present)}</div>
          <div>
            <h3>{item.role}</h3>
            <strong>{item.company}</strong>
            <p>{item.focus[locale]}</p>
            <ul class="tag-list">{item.stack.map((skill) => <li>{skill}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section">
    <h2>{labels.capabilities}</h2>
    <div class="cv-capabilities">
      {capabilities.map((item) => (
        <article><h3>{item.title[locale]}</h3><p>{item.text[locale]}</p><ul class="tag-list">{item.stack.map((skill) => <li>{skill}</li>)}</ul></article>
      ))}
    </div>
  </section>

  <section class="cv-section">
    <h2>{labels.selected}</h2>
    <div class="cv-projects">
      {featured.map((project) => (
        <a href={"/" + locale + "/work/" + project.slug + "/"}>
          <span>{project.category[locale]}</span>
          <strong>{project.name}</strong>
          <p>{project.summary[locale]}</p>
        </a>
      ))}
    </div>
  </section>
</main>

<script>
  document.querySelector("[data-print-cv]")?.addEventListener("click", () => window.print());
</script>
