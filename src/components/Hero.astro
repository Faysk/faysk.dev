---
import { site } from "@data/projects";
import ButtonLink from "./ButtonLink.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{site.name} / {site.role}</p>
    <h1 class="hero-title" id="hero-title">Reliable systems.<br /><span>Repeatable delivery.</span></h1>
    <p class="hero-copy">
      I design, automate and operate the infrastructure behind dependable software — from code and CI/CD to cloud environments and production support.
    </p>
    <div class="hero-actions">
      <ButtonLink href="#projects" label="Explore selected work" variant="primary" />
      <ButtonLink href={site.githubUrl} label="View GitHub ↗" ariaLabel="Open Faysk on GitHub" />
    </div>
  </div>

  <aside class="hero-note" aria-label="Core focus">
    <p class="hero-note-label">Core focus</p>
    <ol>
      <li><span>01</span>Automate the path from commit to production.</li>
      <li><span>02</span>Make infrastructure repeatable and documented.</li>
      <li><span>03</span>Keep critical systems observable and recoverable.</li>
    </ol>
    <p class="hero-note-footer">Infrastructure · CI/CD · Cloud operations</p>
  </aside>
</section>