---
import type { Locale } from "@data/site";
import { getCopy } from "@i18n/index";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{copy.hero.eyebrow}</p>
    <h1 id="hero-title">{copy.hero.titleA}<br /><span>{copy.hero.titleB}</span></h1>
    <p class="hero-copy">{copy.hero.copy}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">{copy.hero.workCta}</a>
      <a class="button" href={"/" + locale + "/cv/"}>{copy.hero.cvCta}</a>
      <a class="text-action" href="#contact">{copy.hero.contactCta}<span aria-hidden="true">↘</span></a>
    </div>
  </div>

  <aside class="pipeline-card" aria-label={copy.hero.pipelineLabel}>
    <div class="pipeline-head">
      <span>{copy.hero.pipelineLabel}</span>
      <span class="pipeline-state"><i aria-hidden="true"></i>{copy.hero.pipelineStatus}</span>
    </div>
    <ol class="pipeline-flow">
      {copy.hero.pipeline.map((item, index) => (
        <li>
          <span class="pipeline-index">{String(index + 1).padStart(2, "0")}</span>
          <strong>{item}</strong>
          {index < copy.hero.pipeline.length - 1 ? <span class="pipeline-line" aria-hidden="true"></span> : null}
        </li>
      ))}
    </ol>
    <p>{copy.hero.pipelineNote}</p>
  </aside>
</section>
