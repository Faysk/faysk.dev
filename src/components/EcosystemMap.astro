---
import { ecosystemSurfaces } from "@data/projects";
---

<section class="section ecosystem-section" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="section-heading">
    <p class="eyebrow">Control surfaces</p>
    <h2 class="section-title" id="ecosystem-title">A small public map for DevOps work, labs and client delivery.</h2>
    <p class="section-copy">
      The root domain explains the operating profile. Labs, tools and portfolio surfaces stay separate so each environment can evolve without breaking the others.
    </p>
  </div>

  <div class="surface-grid">
    {
      ecosystemSurfaces.map((surface, index) => (
        <article class="surface-card" style={`--surface-index: "${String(index + 1).padStart(2, "0")}"`}>
          <div class="surface-topline">
            <span class="surface-label">{surface.label}</span>
            <span class={`surface-state status-${surface.state}`}>{surface.state}</span>
          </div>
          <h3>{surface.domain}</h3>
          <p>{surface.description}</p>
        </article>
      ))
    }
  </div>
</section>
