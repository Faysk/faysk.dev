---
import type { Locale } from "@data/site";
import { capabilities } from "@data/projects";
import { getCopy } from "@i18n/index";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section class="section" id="capabilities" aria-labelledby="capabilities-title">
  <div class="section-heading split-heading">
    <div><p class="eyebrow">{copy.capabilities.eyebrow}</p><h2 id="capabilities-title">{copy.capabilities.title}</h2></div>
    <p>{copy.capabilities.copy}</p>
  </div>
  <div class="capability-grid">
    {capabilities.map((item, index) => (
      <article class="capability-item">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3>{item.title[locale]}</h3>
        <p>{item.text[locale]}</p>
        <ul class="tag-list">{item.stack.map((skill) => <li>{skill}</li>)}</ul>
      </article>
    ))}
  </div>
</section>
