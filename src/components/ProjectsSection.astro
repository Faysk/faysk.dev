---
import type { Locale } from "@data/site";
import { projects } from "@data/projects";
import { getCopy } from "@i18n/index";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
const featured = projects.filter((project) => project.featured);
const more = projects.filter((project) => !project.featured);
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="section-heading split-heading">
    <div><p class="eyebrow">{copy.work.eyebrow}</p><h2 id="work-title">{copy.work.title}</h2></div>
    <p>{copy.work.copy}</p>
  </div>

  <div class="featured-work">
    {featured.map((project, index) => (
      <article class="featured-project">
        <div class="project-media">
          <img src={project.image} alt={project.imageAlt[locale]} width="1440" height="900" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          <span class="project-sequence">{String(index + 1).padStart(2, "0")}</span>
        </div>
        <div class="project-copy">
          <p class="project-kicker">{project.category[locale]} <span aria-hidden="true">/</span> {copy.common.status[project.status]}</p>
          <h3>{project.name}</h3>
          <p class="project-summary">{project.summary[locale]}</p>
          <ul class="tag-list" aria-label={project.name + " technologies"}>{project.stack.map((item) => <li>{item}</li>)}</ul>
          <div class="project-actions">
            <a class="button button-primary" href={"/" + locale + "/work/" + project.slug + "/"}>{copy.work.caseStudy}</a>
            {project.url ? <a class="button" href={project.url} target="_blank" rel="noopener noreferrer">{copy.work.live} ↗</a> : null}
            {project.repo ? <a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">{copy.work.source} ↗</a> : null}
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="more-work">
    <div class="more-work-head"><h3>{copy.work.more}</h3><span>{String(more.length).padStart(2, "0")}</span></div>
    <div class="more-work-grid">
      {more.map((project) => (
        <article class="compact-project">
          <img src={project.image} alt={project.imageAlt[locale]} width="720" height="450" loading="lazy" decoding="async" />
          <div>
            <p>{project.category[locale]}</p>
            <h3>{project.name}</h3>
            <p>{project.summary[locale]}</p>
            <a class="text-link" href={"/" + locale + "/work/" + project.slug + "/"}>{copy.work.caseStudy} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
