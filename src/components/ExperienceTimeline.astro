---
import type { Locale } from "@data/site";
import { experience } from "@data/projects";
import { getCopy } from "@i18n/index";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading">
    <p class="eyebrow">{copy.experience.eyebrow}</p>
    <h2 id="experience-title">{copy.experience.title}</h2>
    <p>{copy.experience.copy}</p>
  </div>
  <div class="experience-list">
    {experience.map((item) => (
      <article class="experience-row">
        <p class="experience-period">{item.period}</p>
        <div class="experience-main">
          <div class="experience-title"><h3>{item.role}</h3><span>{item.company}</span></div>
          <p>{item.focus[locale]}</p>
          <ul class="tag-list" aria-label={item.company + " " + copy.common.technologies}>{item.stack.map((skill) => <li>{skill}</li>)}</ul>
        </div>
      </article>
    ))}
  </div>
</section>
