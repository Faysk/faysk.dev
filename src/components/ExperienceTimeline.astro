---
import { careerTimeline } from "@data/projects";
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading">
    <p class="eyebrow">Experience</p>
    <h2 class="section-title" id="experience-title">Built from support up.</h2>
    <p class="section-copy">
      Hands-on experience across software, infrastructure and operations — the layers that make reliable delivery possible.
    </p>
  </div>

  <div class="experience-list">
    {
      careerTimeline.map((item) => (
        <article class="experience-row">
          <p class="experience-period">{item.period}</p>
          <div class="experience-main">
            <div class="experience-title">
              <h3>{item.role}</h3>
              <p>{item.company}</p>
            </div>
            <p class="experience-copy">{item.focus}</p>
            <ul class="tag-list" aria-label={item.company + " stack"}>
              {item.stack.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>