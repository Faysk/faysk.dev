---
import { careerTimeline } from "@data/projects";

function iconPath(icon: string) {
  const paths = {
    shield: "M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3zm0 5v9",
    pipeline: "M4 7h5l2 3h9M4 17h5l2-3h9M16 10l4 4-4 4",
    cloud: "M8 18h9a4 4 0 0 0 0-8 6 6 0 0 0-11-1A4.5 4.5 0 0 0 8 18z",
    server: "M5 5h14v6H5V5zm0 8h14v6H5v-6zm3-5h.01M8 16h.01",
    code: "M9 7l-5 5 5 5m6-10l5 5-5 5",
    monitor: "M4 5h16v10H4V5zm6 14h4m-6 0h8"
  };
  return paths[icon as keyof typeof paths] ?? paths.pipeline;
}
---

<section class="section experience-section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading">
    <p class="eyebrow">DevOps conveyor</p>
    <h2 class="section-title" id="experience-title">A career pipeline across support, software, infrastructure and automation.</h2>
    <p class="section-copy">
      The timeline is treated like a delivery belt: each role added another stage to how I build, automate, operate and stabilize systems.
    </p>
  </div>

  <div class="timeline-rail" aria-hidden="true">
    <span>Support</span>
    <span>Build</span>
    <span>Stabilize</span>
    <span>Automate</span>
    <span>Deliver</span>
    <span>Operate</span>
  </div>

  <div class="timeline-list">
    {
      careerTimeline.map((item) => (
        <article class="timeline-item">
          <div class="timeline-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d={iconPath(item.icon)} />
            </svg>
          </div>
          <span class="timeline-period">{item.period}</span>
          <div class="timeline-body">
            <div>
              <p class="timeline-stage">{item.stage}</p>
              <h3>{item.company}</h3>
              <p class="timeline-role">{item.role}</p>
            </div>
            <p>{item.focus}</p>
            <ul class="tag-list" aria-label={`${item.company} stack`}>
              {item.stack.map((skill) => <li class="tag">{skill}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
