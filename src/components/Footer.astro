---
import type { Locale } from "@data/site";
import { site } from "@data/site";
import { getCopy } from "@i18n/index";
import ContactForm from "./ContactForm.astro";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
const year = new Date().getFullYear();
---

<footer class="footer" id="contact" aria-labelledby="contact-title">
  <div class="contact-layout">
    <div class="contact-intro">
      <p class="eyebrow">{copy.contact.eyebrow}</p>
      <h2 id="contact-title">{copy.contact.title}</h2>
      <p>{copy.contact.copy}</p>
      <div class="direct-contact"><span>{copy.contact.direct}</span><a href={"mailto:" + site.email}>{site.email}</a></div>
    </div>
    <ContactForm locale={locale} />
  </div>
  <div class="footer-bottom">
    <div><strong>© {year} {site.brand} / {site.personName}</strong><span>{copy.footer.note}</span></div>
    <nav aria-label={copy.common.footerNav}>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={site.lab} target="_blank" rel="noopener noreferrer">Lab ↗</a>
      <a href={"/" + locale + "/cv/"}>CV</a>
      <a href="#main-content">{copy.footer.back} ↑</a>
    </nav>
  </div>
</footer>
