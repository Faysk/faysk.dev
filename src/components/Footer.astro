---
import { site } from "@data/projects";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <span>{site.name} / {year}</span>
    <nav class="footer-links" aria-label="Footer navigation">
      <a class="text-link" href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-link" href={site.labUrl} target="_blank" rel="noreferrer">Lab</a>
      <a class="text-link" href="#projects">Projects</a>
    </nav>
  </div>
</footer>
