---
import { site } from "@data/projects";
import ContactForm from "./ContactForm.astro";

const year = new Date().getFullYear();
---

<footer class="footer" id="contact" aria-labelledby="contact-title">
  <div class="footer-callout">
    <div class="footer-intro">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Have a system that needs simplifying?</h2>
      <p class="footer-copy">
        Write your message here and open a ready-to-send draft addressed to {site.contactEmail}. Nothing is stored by this site.
      </p>
    </div>

    <ContactForm />
  </div>

  <div class="footer-bottom">
    <span>© {year} {site.owner}</span>
    <nav class="footer-links" aria-label="Footer navigation">
      <a class="text-link" href={"mailto:" + site.contactEmail}>Email</a>
      <a class="text-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a class="text-link" href={site.labUrl} target="_blank" rel="noopener noreferrer">Lab ↗</a>
      <a class="text-link" href="#main-content">Back to top ↑</a>
    </nav>
  </div>
</footer>
