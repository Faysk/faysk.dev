---
import type { Project } from "@data/projects";
import ButtonLink from "./ButtonLink.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const statusClass = "status-" + project.status;
const previewLabel = project.status === "private"
  ? "Private product"
  : project.status === "live"
    ? "Live preview"
    : "Experiment preview";
const primaryLabel = project.status === "private" ? "Open sign-in ↗" : "View live ↗";
---

<article class="project-row">
  <span class="project-number" aria-hidden="true">{number}</span>

  <figure class="project-media">
    <img
      src={project.image}
      alt={project.imageAlt}
      width="1440"
      height="900"
      loading="lazy"
      decoding="async"
    />
    <figcaption>{previewLabel}</figcaption>
  </figure>

  <div class="project-main">
    <p class="project-meta">
      <span>{project.featured ? "Featured work" : project.type}</span>
      <span aria-hidden="true">·</span>
      <span class={statusClass}>{project.status}</span>
    </p>
    <h3 class="project-title">{project.name}</h3>
    <p class="project-description">{project.description}</p>
    <ul class="tag-list" aria-label={project.name + " stack"}>
      {project.stack.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="project-links">
    <ButtonLink href={project.url} label={primaryLabel} ariaLabel={"Open " + project.name} variant="primary" />
    {project.repo ? <ButtonLink href={project.repo} label="Source ↗" ariaLabel={"Open " + project.name + " repository"} /> : null}
  </div>
</article>