---
import { capabilities } from "@data/projects";
---

<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="section-heading">
    <p class="eyebrow">How I work</p>
    <h2 class="section-title" id="approach-title">Automate the repeatable. Make the critical observable.</h2>
    <p class="section-copy">
      Good operations should reduce cognitive load: clear ownership, documented systems and predictable recovery when something goes wrong.
    </p>
  </div>

  <div class="capability-list">
    {
      capabilities.map((capability, index) => (
        <article class="capability-row">
          <span class="capability-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{capability.title}</h3>
            <p>{capability.text}</p>
            <ul class="tag-list" aria-label={capability.title + " tools"}>
              {capability.stack.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>