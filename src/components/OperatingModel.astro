---
import { operatingNotes } from "@data/projects";
---

<section class="section" id="system" aria-labelledby="system-title">
  <div class="section-heading">
    <p class="eyebrow">Operating model</p>
    <h2 class="section-title" id="system-title">The work is DevOps: automate delivery and keep systems stable.</h2>
    <p class="section-copy">
      The site is the public layer; the story behind it is infrastructure, CI/CD, cloud operations, monitoring, troubleshooting and repeatable delivery.
    </p>
  </div>

  <div class="bento-grid">
    {
      operatingNotes.map((note, index) => (
        <article class={`bento-card ${index === 0 ? "large" : "small"}`}>
          <p class="eyebrow">{note.title}</p>
          <strong class="bento-value">{note.value}</strong>
          <p>{note.text}</p>
        </article>
      ))
    }
  </div>
</section>
