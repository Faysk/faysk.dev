---
import { site } from "@data/projects";
import ButtonLink from "./ButtonLink.astro";
---

<header class="site-header">
  <a class="brand" href="/" aria-label="faysk.dev home">
    <img class="brand-mark" src="/assets/icons/mark.svg" alt="" width="36" height="36" />
    <span class="brand-copy">
      <strong>{site.name}</strong>
      <span>{site.role}</span>
    </span>
  </a>

  <nav class="nav-links" aria-label="Primary navigation">
    <a href="#projects">Work</a>
    <a href="#experience">Experience</a>
    <a class="nav-optional" href="#approach">Approach</a>
    <a href="#contact">Contact</a>
  </nav>

  <div class="header-actions" aria-label="External links">
    <a class="header-link" href={site.labUrl} target="_blank" rel="noopener noreferrer">Lab ↗</a>
    <ButtonLink href={site.githubUrl} label="GitHub ↗" ariaLabel="Open Faysk on GitHub" />
  </div>
</header>