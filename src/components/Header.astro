---
import type { Locale } from "@data/site";
import { site } from "@data/site";
import { getCopy } from "@i18n/index";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getCopy(locale);
const base = "/" + locale + "/";
---

<header class="site-header">
  <a class="brand" href={base} aria-label={copy.common.home}>
    <img class="brand-mark" src="/assets/icons/mark.svg" alt="" width="36" height="36" />
    <span class="brand-copy"><strong>{site.brand}</strong><span>{site.personName}</span></span>
  </a>

  <nav class="desktop-nav" aria-label={copy.common.primaryNav}>
    <a href={base + "#work"}>{copy.nav.work}</a>
    <a href={base + "#solutions"}>{copy.nav.solutions}</a>
    <a href={base + "#experience"}>{copy.nav.experience}</a>
    <a href={base + "#contact"}>{copy.nav.contact}</a>
  </nav>

  <div class="header-utilities">
    <LanguageSwitcher locale={locale} />
    <ThemeToggle locale={locale} />
    <a class="icon-link desktop-only" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.5 8.3V19M6.5 5.1v.1M10.5 19v-6.2c0-2.1 1.2-3.5 3-3.5 2 0 3 1.3 3 3.5V19M3.5 8.3h6M3.5 19h6M10.5 9.8h3"></path></svg>
    </a>
    <a class="icon-link desktop-only" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 19c-4 .8-4-2-5-2.5M14.5 22v-3.1c0-.9.1-1.5-.4-2 3.4-.4 7-1.7 7-7.5a5.9 5.9 0 0 0-1.6-4.1 5.5 5.5 0 0 0-.2-4.1s-1.2-.4-4.3 1.6a14.8 14.8 0 0 0-7.8 0C4.1.8 2.9 1.2 2.9 1.2a5.5 5.5 0 0 0-.2 4.1 5.9 5.9 0 0 0-1.6 4.1c0 5.8 3.6 7.1 7 7.5-.4.4-.6.9-.6 1.8V22"></path></svg>
    </a>
    <details class="mobile-nav">
      <summary
        aria-label={copy.common.openNav}
        data-open-label={copy.common.openNav}
        data-close-label={copy.common.closeNav}
      >
        <svg class="menu-open" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="menu-close" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </summary>
      <div class="mobile-nav-panel">
        <nav aria-label={copy.common.mobileNav}>
          <a href={base + "#work"}>{copy.nav.work}</a>
          <a href={base + "#solutions"}>{copy.nav.solutions}</a>
          <a href={base + "#experience"}>{copy.nav.experience}</a>
          <a href={base + "#capabilities"}>{copy.nav.capabilities}</a>
          <a href={base + "#contact"}>{copy.nav.contact}</a>
          <a href={base + "cv/"}>{copy.nav.cv}</a>
        </nav>
        <div class="mobile-external">
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const details = document.querySelector(".mobile-nav");
  const summary = details?.querySelector("summary");

  const syncLabel = () => {
    if (!details || !summary) return;
    const label = details.hasAttribute("open")
      ? summary.getAttribute("data-close-label")
      : summary.getAttribute("data-open-label");
    if (label) summary.setAttribute("aria-label", label);
  };

  details?.addEventListener("toggle", syncLabel);

  details?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest("a")) details.removeAttribute("open");
  });

  document.addEventListener("pointerdown", (event) => {
    const target = event.target;
    if (
      details?.hasAttribute("open") &&
      target instanceof Node &&
      !details.contains(target)
    ) {
      details.removeAttribute("open");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && details?.hasAttribute("open")) {
      details.removeAttribute("open");
      summary?.focus();
    }
  });

  syncLabel();
</script>
