---
import { stackPrinciples } from "@data/projects";
---

<section class="section stack-section" aria-labelledby="stack-title">
  <div class="section-heading">
    <p class="eyebrow">Capability stack</p>
    <h2 class="section-title" id="stack-title">Automation, infrastructure and operations as the core signal.</h2>
    <p class="section-copy">
      The public site stays simple, but the professional focus is DevOps: pipelines, cloud environments, IaC, observability and production support.
    </p>
  </div>

  <div class="stack-grid">
    {
      stackPrinciples.map((card) => (
        <article class="stack-card">
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))
    }
  </div>
</section>
